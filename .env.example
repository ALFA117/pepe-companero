# Copia este archivo a .env.local y llénalo. .env.local NUNCA se sube al repo.

# ── IA ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
MODEL_PEPE=claude-haiku-5-5
MODEL_JUEZ=claude-sonnet-5-5
OPENAI_API_KEY=                # Whisper (whisper-1) para transcribir con marcas de tiempo por palabra

# ── Supabase ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=      # https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # service_role (o la nueva "secret key" sb_secret_...). SOLO servidor

# ── WhatsApp ─────────────────────────────────────────
CANAL_WHATSAPP=kapso           # kapso | twilio
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=          # se define al crear el webhook en Kapso (apunta al dominio de producción)
KAPSO_PHONE_NUMBER_ID=

# Respaldo (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=          # whatsapp:+14155238886 en el sandbox

# ── Secretos que generamos nosotros (no vienen de ningún servicio) ──
TEL_HASH_SALT=                 # openssl rand -hex 32
TEL_CIFRADO_KEY=               # openssl rand -base64 32  (AES-256-GCM, 32 bytes)
DOCENTE_PIN=                   # PIN del panel /docente
