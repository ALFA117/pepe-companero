# Copia este archivo a .env.local y llénalo. .env.local NUNCA se sube al repo.

# ── IA ───────────────────────────────────────────────
# console.groq.com → API Keys. Se usa para Pepe, el Juez y la transcripción.
GROQ_API_KEY=
# aistudio.google.com → Get API key. Modelo de respaldo si Groq falla o se satura.
GOOGLE_GENERATIVE_AI_API_KEY=
# Opcional: si se usan modelos de Anthropic (anthropic:claude-haiku-5-5)
ANTHROPIC_API_KEY=

# Modelos (formato proveedor:modelo; proveedores: groq, google, anthropic)
MODEL_PEPE=groq:openai/gpt-oss-20b
MODEL_JUEZ=groq:openai/gpt-oss-120b
MODEL_RESPALDO=google:gemini-3.8-flash
# Voz a texto (Groq, con marcas de tiempo por palabra)
MODEL_STT=whisper-large-v3-turbo

# ── Supabase ─────────────────────────────────────────
BASE_DATOS=auto                # auto | supabase | memoria (memoria = solo para probar en local)
NEXT_PUBLIC_SUPABASE_URL=      # https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # SOLO servidor. Sin estas dos, la app usa una base en memoria

# ── WhatsApp ─────────────────────────────────────────
CANAL_WHATSAPP=kapso           # kapso | twilio
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=          # openssl rand -hex 32 (el mismo valor va en el webhook de Kapso)
KAPSO_PHONE_NUMBER_ID=

# Respaldo (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Secretos que generamos nosotros ──
TEL_HASH_SALT=                 # openssl rand -hex 32
TEL_CIFRADO_KEY=               # openssl rand -base64 32  (AES-256-GCM, 32 bytes)
DOCENTE_PIN=                   # PIN del panel /docente
